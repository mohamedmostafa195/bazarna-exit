# ── Vercel (required) ──────────────────────────────────────────────
# Create free Postgres at https://neon.tech — copy the connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

AUTH_SECRET="generate-a-long-random-string-here"
NEXTAUTH_SECRET="generate-a-long-random-string-here"
NEXTAUTH_URL="https://bazarna-exit-8i2q.vercel.app"
NEXT_PUBLIC_APP_URL="https://bazarna-exit-8i2q.vercel.app"

# ── After setting DATABASE_URL on Vercel, run once on your machine: ─
#   set DATABASE_URL=postgresql://...   (PowerShell: $env:DATABASE_URL="...")
#   npx prisma db push
#   npx tsx prisma/seed.ts
# Then redeploy on Vercel.

# ── Local dev ───────────────────────────────────────────────────────
# Use the same Neon URL (or a second Neon database). SQLite is not used.

# Optional - email notifications
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Bazarna <onboarding@resend.dev>"
