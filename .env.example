# Required for Vercel deployment
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="generate-a-long-random-string-here"
NEXTAUTH_SECRET="generate-a-long-random-string-here"
NEXTAUTH_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Optional - email notifications
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Bazarna <onboarding@resend.dev>"

# Local dev: use a free Neon (neon.tech) or Supabase Postgres URL above.
# SQLite is NOT supported on Vercel.
