# ── Vercel setup (required) ─────────────────────────────────────────

# 1. Create free Postgres at https://neon.tech
# 2. Copy the connection string (use "Direct" / non-pooler URL from Neon)

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

AUTH_SECRET="run: openssl rand -base64 32"
NEXTAUTH_SECRET="same-as-AUTH_SECRET"
NEXTAUTH_URL="https://bazarna-exit-8i2q.vercel.app"
NEXT_PUBLIC_APP_URL="https://bazarna-exit-8i2q.vercel.app"

# 3. Vercel → Project → Settings → Environment Variables
#    Add ALL variables above → Production + Preview + Development
# 4. Redeploy → build runs prisma db push (creates tables automatically)
# 5. Seed admins once on your PC:
#    $env:DATABASE_URL="postgresql://..."
#    npx tsx prisma/seed.ts
# 6. Test: https://bazarna-exit-8i2q.vercel.app/api/health

# ── Local dev: use the same Neon URL in .env (SQLite does not work on Vercel)

RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Bazarna <onboarding@resend.dev>"
