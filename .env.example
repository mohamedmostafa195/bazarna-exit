# ── Vercel setup (required) ─────────────────────────────────────────

# 1. Create free Postgres at https://neon.tech
# 2. Copy the connection string (use "Direct" / non-pooler URL from Neon)

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&connection_limit=20&pool_timeout=30"

AUTH_SECRET="run: openssl rand -base64 32"
NEXTAUTH_SECRET="same-as-AUTH_SECRET"
NEXTAUTH_URL="https://bazarna-exit.vercel.app"
NEXT_PUBLIC_APP_URL="https://bazarna-exit.vercel.app"
AUTH_URL="https://bazarna-exit.vercel.app"

# 3. Vercel → Project → Settings → Environment Variables
#    Add ALL variables above → Production + Preview + Development
# 4. Redeploy → build runs prisma db push (creates tables automatically)
# 5. Seed admins once on your PC:
#    $env:DATABASE_URL="postgresql://..."
#    npx tsx prisma/seed.ts
# 6. Test: https://bazarna-exit.vercel.app/api/health

# ── Local dev: use the same Neon URL in .env (SQLite does not work on Vercel)

# ── Email (pick ONE provider — Gmail SMTP recommended for quick setup) ──
#
# WHY emails go to spam:
# - Sending from @gmail.com via Brevo/Resend fails DMARC → spam folder
# - Fix: use Gmail SMTP (sender = your Gmail) OR verify your own domain
#
# Option A — Gmail SMTP (best if you only have a Gmail address):
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your@gmail.com"
SMTP_PASS="your-16-char-google-app-password"
SMTP_FROM_EMAIL="your@gmail.com"
SMTP_FROM_NAME="Bazarna Exit Queue"
EMAIL_REPLY_TO="your@gmail.com"
# Remove or comment out BREVO_API_KEY when using SMTP
#
# Option B — Resend with verified domain (best for production):
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Bazarna Exit Queue <noreply@yourdomain.com>"
# EMAIL_REPLY_TO="support@yourdomain.com"
#
# Option C — Brevo (only with a verified custom domain, NOT @gmail.com):
# EMAIL_PROVIDER="brevo"
# BREVO_API_KEY="xkeysib-..."
# BREVO_SENDER_EMAIL="noreply@yourdomain.com"
# BREVO_SENDER_NAME="Bazarna Exit Queue"
